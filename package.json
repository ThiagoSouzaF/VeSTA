{
  "name": "vesta",
  "version": "0.11.0",
  "description": "O centro do seu lar digital: agentes, projetos e memória",
  "author": "VeSTA",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "start": "electron .",
    "build": "vite build && vite build --config vite.mobile.config.mjs",
    "test": "node --test test/*.test.cjs",
    "dist": "npm run build && electron-builder --win portable --x64",
    "installer": "npm run build && electron-builder --win nsis --x64",
    "release": "node scripts/release.cjs",
    "format": "prettier --write \"electron/**/*.cjs\" \"src/**/*.{jsx,js,css}\" \"mobile/**/*.{jsx,js,mjs,css}\" \"test/**/*.cjs\" \"scripts/**/*.cjs\" \"vite*.mjs\"",
    "format:check": "prettier --check \"electron/**/*.cjs\" \"src/**/*.{jsx,js,css}\" \"mobile/**/*.{jsx,js,mjs,css}\" \"test/**/*.cjs\" \"scripts/**/*.cjs\" \"vite*.mjs\"",
    "dev:mobile": "vite --config vite.mobile.config.mjs --host 127.0.0.1"
  },
  "dependencies": {
    "@fontsource/space-grotesk": "5.3.0",
    "@fontsource/space-mono": "5.3.0",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "dompurify": "^3.2.0",
    "fflate": "0.8.2",
    "json5": "^2.2.3",
    "lucide-react": "^0.468.0",
    "marked": "^15.0.0",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.4.0",
    "electron": "^44.7.2",
    "electron-builder": "^26.0.0",
    "playwright": "^1.56.0",
    "png-to-ico": "^3.0.2",
    "prettier": "^3.3.3",
    "sharp": "^0.35.5",
    "vite": "^6.3.0"
  },
  "build": {
    "appId": "app.vesta.desktop",
    "productName": "VeSTA",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-mobile/**/*",
      "electron/**/*",
      "package.json",
      "assets/vesta.png"
    ],
    "extraResources": [
      {
        "from": "runtime/ai-memory.exe",
        "to": "ai-memory.exe"
      },
      {
        "from": "runtime/LICENSE",
        "to": "AI-MEMORY-LICENSE"
      }
    ],
    "win": {
      "target": "portable",
      "artifactName": "VeSTA-${version}.exe",
      "icon": "assets/vesta.ico",
      "signExecutable": false
    },
    "compression": "normal",
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowElevation": false,
      "createStartMenuShortcut": true,
      "createDesktopShortcut": false,
      "shortcutName": "VeSTA",
      "runAfterFinish": false,
      "deleteAppDataOnUninstall": false,
      "artifactName": "VeSTA-Setup-${version}.exe",
      "installerIcon": "assets/vesta.ico",
      "uninstallerIcon": "assets/vesta.ico",
      "include": "installer/refresh-icons.nsh"
    }
  }
}
